# Runtime
NODE_ENV=development
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL
DATABASE_URL=postgresql://voltra:voltra@localhost:5432/voltra

# Redis + BullMQ
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (foto/suara privat)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=voltra-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Auth / OTP (penyedia belum diputuskan, O27)
OTP_PROVIDER=
OTP_API_KEY=
SESSION_SECRET=

# AI Gateway
AI_MODE=mock
AI_MODE_OCR_METER=mock
AI_MODE_OCR_LABEL=mock
AI_MODE_OCR_TOKEN=mock
AI_MODE_STT_EXTRACT=mock
AI_MODE_ESTIMATE=mock
AI_MODE_ESTIMATE_CROSSCHECK=mock
AI_MODE_RECOMMEND=mock
AI_MODE_EXPLAIN=mock
AI_MODE_ASK=mock
AI_PROVIDER_API_KEY=

# Pembayaran (penyedia belum diputuskan)
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
