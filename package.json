{
  "name": "voltra",
  "version": "0.0.0",
  "private": true,
  "description": "Voltra - analisis biaya listrik UMKM, Kios Virtual, dan AI energy assistant",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @voltra/contracts build && pnpm --filter @voltra/energy-calc build",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter @voltra/web --filter @voltra/api dev",
    "lint": "eslint .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc -p tsconfig.tests.json --noEmit",
    "test": "pnpm build:packages && vitest run",
    "test:contract": "pnpm build:packages && vitest run tests/contract --passWithNoTests"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "^12.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
